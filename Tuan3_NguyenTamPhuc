Da luu file Excel: /kaggle/working/w3_mscoco2017_v1/metrics/four_models_final_results.xlsx\n\n===== NHAN XET TU DONG =====\nCIDEr cao nhat: CLIP-ViT-B/16 (0.9589)\nSuy luan nhanh nhat: EfficientNet-B3 (94.23 ms/anh)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1300x450 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":88},{"cell_type":"markdown","source":"## Tự động tìm 3 hình ảnh minh họa","metadata":{}},{"cell_type":"code","source":"from nltk.translate.bleu_score import sentence_bleu, SmoothingFunction\nfrom itertools import combinations\n\n# Tai prediction cua ca 4 model\npredictions_by_model = {}\nfor m in REQUIRED_MODELS:\n    with open(PREDICTION_DIR / f\"{m}_beam_predictions.json\", \"r\", encoding=\"utf-8\") as f:\n        data = json.load(f)\n    assert data[\"model_name\"] == m\n    predictions_by_model[m] = data[\"predictions\"]\nprint(\"Da tai prediction cua ca 4 model.\")\n\nsmoothing = SmoothingFunction().method1\n\n\ndef sentence_bleu4(references, prediction):\n    ref_tokens = [tokenize(r) for r in references]\n    pred_tokens = tokenize(prediction)\n    if not pred_tokens:\n        return 0.0\n    return sentence_bleu(ref_tokens, pred_tokens, weights=(0.25, 0.25, 0.25, 0.25),\n                          smoothing_function=smoothing)\n\n\ndef word_set_distance(caption_a, caption_b):\n    words_a, words_b = set(tokenize(caption_a)), set(tokenize(caption_b))\n    union = words_a | words_b\n    if not union:\n        return 0.0\n    return 1.0 - len(words_a & words_b) / len(union)\n\n\ncase_scores = []\nfor image_name in test_images:\n    references = captions_by_image[image_name]\n    model_captions = {m: predictions_by_model[m][image_name] for m in REQUIRED_MODELS}\n    bleu_scores = [sentence_bleu4(references, model_captions[m]) for m in REQUIRED_MODELS]\n    pairwise_distances = [word_set_distance(model_captions[a], model_captions[b])\n                           for a, b in combinations(REQUIRED_MODELS, 2)]\n    case_scores.append({\n        \"image\": image_name,\n        \"mean_sentence_bleu4\": sum(bleu_scores) / len(bleu_scores),\n        \"caption_disagreement\": sum(pairwise_distances) / len(pairwise_distances),\n    })\n\ncase_score_df = pd.DataFrame(case_scores)\n\n# Anh 1: ca 4 model deu mo ta tot (BLEU trung binh cao nhat)\ngood_image = case_score_df.sort_values(\"mean_sentence_bleu4\", ascending=False).iloc[0][\"image\"]\n\n# Anh 2: 4 model cho ket qua khac biet ro ret nhat (loai anh 1 ra truoc)\nremaining_df = case_score_df[case_score_df[\"image\"] != good_image]\ndifferent_image = remaining_df.sort_values(\"caption_disagreement\", ascending=False).iloc[0][\"image\"]\n\n# Anh 3: ca 4 model deu mo ta kem (BLEU trung binh thap nhat, loai 2 anh tren)\nremaining_df2 = remaining_df[remaining_df[\"image\"] != different_image]\nbad_image = remaining_df2.sort_values(\"mean_sentence_bleu4\", ascending=True).iloc[0][\"image\"]\n\nselected_cases = {\n    \"1. Ca 4 model mo ta TOT\": good_image,\n    \"2. 4 model cho ket qua KHAC BIET\": different_image,\n    \"3. Ca 4 model mo ta CHUA TOT\": bad_image,\n}\nprint(\"Da chon duoc 3 anh minh hoa:\")\nfor title, name in selected_cases.items():\n    print(f\"  {title}: {name}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T14:05:38.032690Z","iopub.execute_input":"2026-08-08T14:05:38.033824Z","iopub.status.idle":"2026-08-08T14:05:43.600789Z","shell.execute_reply.started":"2026-08-08T14:05:38.033759Z","shell.execute_reply":"2026-08-08T14:05:43.600123Z"}},"outputs":[{"name":"stdout","text":"Da tai prediction cua ca 4 model.\nDa chon duoc 3 anh minh hoa:\n  1. Ca 4 model mo ta TOT: 435922\n  2. 4 model cho ket qua KHAC BIET: 561928\n  3. Ca 4 model mo ta CHUA TOT: 355453\n","output_type":"stream"}],"execution_count":89},{"cell_type":"markdown","source":"## Hiển thị 3 ảnh + caption tham chiếu + Caption 4 model","metadata":{}},{"cell_type":"code","source":"def show_qualitative_cas