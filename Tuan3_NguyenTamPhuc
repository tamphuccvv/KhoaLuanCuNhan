k = torch.load(cache_path, map_location=\"cpu\", weights_only=False)\n        print(\"Feature shape:\", feature_pack[\"features\"].shape)\n        assert feature_pack[\"features\"].shape[0] == len(all_used_images)\n        return feature_pack\n\n    encoder, transform, feature_dim, weight_name = build_encoder(model_name, DEVICE)\n\n    dataset = ImageFeatureDataset(all_used_images, image_path_by_name, transform)\n    loader = DataLoader(dataset, batch_size=batch_size, shuffle=False,\n                         num_workers=2, pin_memory=torch.cuda.is_available())\n\n    encoder_parameter_count = sum(p.numel() for p in encoder.parameters())\n\n    all_features, extracted_names = [], []\n    if torch.cuda.is_available():\n        torch.cuda.synchronize()\n    start_time = time.perf_counter()\n\n    with torch.inference_mode():\n        for images, names in tqdm(loader, desc=f\"Trich feature ({model_name})\"):\n            images = images.to(DEVICE)\n            feats = encoder(images).float().cpu()\n            all_features.append(feats)\n            extracted_names.extend(names)\n\n    if torch.cuda.is_available():\n        torch.cuda.synchronize()\n    extraction_seconds = time.perf_counter() - start_time\n\n    features_tensor = torch.cat(all_features, dim=0).half()  \n\n    feature_pack = {\n        \"features\": features_tensor,\n        \"image_names\": extracted_names,\n        \"metadata\": {\n            \"model_name\": model_name,\n            \"weight_name\": weight_name,\n            \"feature_dim\": feature_dim,\n            \"encoder_parameter_count\": encoder_parameter_count,\n            \"extraction_seconds\": extraction_seconds,\n            \"num_images\": len(extracted_names),\n        },\n    }\n    torch.save(feature_pack, cache_path)\n    print(f\"Da luu feature cache: {cache_path} ({extraction_seconds:.1f}s, \"\n          f\"{features_tensor.shape[0]} anh x {features_tensor.shape[1]} chieu)\")\n\n    del encoder\n    gc.collect()\n    if torch.cuda.is_available():\n        torch.cuda.empty_cache()\n\n    return feature_pack\n\n\nfeature_pack = extract_and_cache_features(MODEL_TO_RUN, batch_size=64, force_extract=False)\nprint(json.dumps(feature_pack[\"metadata\"], indent=2, ensure_ascii=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T13:05:33.737845Z","iopub.execute_input":"2026-08-08T13:05:33.738253Z","iopub.status.idle":"2026-08-08T13:24:25.257145Z","shell.execute_reply.started":"2026-08-08T13:05:33.738224Z","shell.execute_reply":"2026-08-08T13:24:25.256005Z"}},"outputs":[{"name":"stdout","text":"Tong so anh can trich dac trung: 92783\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Trich feature (clip_vit_b16):   0%|          | 0/1450 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d9b68141a4024772b58dc3509e0ddfa5"}},"metadata":{}},{"name":"stdout","text":"Da luu feature cache: /kaggle/working/w3_mscoco2017_v1/features/clip_vit_b16_features.pt (1115.1s, 92783 anh x 512 chieu)\n{\n  \"model_name\": \"clip_vit_b16\",\n  \"weight_name\": \"OpenAI CLIP ViT-B/16\",\n  \"feature_dim\": 512,\n  \"encoder_parameter_count\": 86192640,\n  \"extraction_seconds\": 1115.1485474180008,\n  \"num_images\": 92783\n}\n","output_type":"stream"}],"execution_count":77},{"cell_type":"markdown","source":"# Dataset & Dataloader huấn luyện Decoder","metadata":{}},{"cell_type":"code","source":"class FeatureCaptionDataset(Dataset):\n    def __init__(self, feature_pack, selected_image_names, captions_by_image):\n        self.feature_tensor = feature_pack[\"features\"]\n        self.feature_index = {name: i for i, name in enumerate(feature_pack[\"image_names\"])}\n\n        self.samples = []\n        for image_name in selected_image_names:\n            for caption in captions_by_image[image_name]:\n                self.samples.append((image_name, caption))\n\n    def __len__(self):\n        return len(self.samples)\n\n    def __getitem__(self, idx):\n        image_name, caption = self.samples[idx]\n        feature = self.feature_tensor[self.feature_index[image_name]].float()  \n        caption_ids = encode_caption(caption)\n        return feature, caption_ids, image_name\n\n\ndef caption_collate_fn(batch):\n    features, captions, names = zip(*batch)\n    features = torch.stack(features, dim=0)\n    captions = pad_sequence(captions, batch_first=True, padding_value=PAD_ID)\n    return features, captions, names\n\n\ndef create_caption_loaders(feature_pack, batch_size=TRAIN_CONFIG[\"batch_size\"]):\n    train_dataset = FeatureCaptionDataset(feature_pack, train_images, captions_by_image)\n    val_dataset = FeatureCaptionDataset(feature_pack, val_images, captions_by_image)\n\n    g = torch.Generator()\n    g.manual_seed(42)\n\n    train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True,\n                               collate_fn=caption_collate_fn, num_workers=0,\n                               pin_memory=torch.cuda.is_available(), generator=g)\n    val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False,\n                             collate_fn=caption_collate_fn, num_workers=0,\n                             pin_memory=torch.cuda.is_available())\n\n    print(\"Train samples:\", len(train_dataset), \"| Val samples:\", len(val_dataset))\n    print(\"Train batches:\", len(train_loader), \"| Val batches:\", len(val_loader))\n    return train_loader, val_loader\n\n\ntrain_loader, val_loader = create_caption_loaders(feature_pack)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T13:24:25.259020Z","iopub.execute_input":"2026-08-08T13:24:25.259647Z","iopub.status.idle":"2026-08-08T13:24:25.663568Z","shell.execute_reply.started":"2026-08-08T13:24:25.259597Z","shell.execute_reply":"2026-08-08T13:24:25.662815Z"}},"outputs":[{"name":"stdout","text":"Train samples: 414113 | Val samples: 25010\nTrain batches: 3236 | Val batches: 196\n","output_type":"stream"}],"execution_count":78},{"cell_type":"markdown","source":"# Transformer Decoder","metadata":{}},{"cell_type":"code","source":"class ImageCaptionTransformer(nn.Module):\n    def __init__(self, feature_dim, vocab_size, d_model=256, nhead=8, num_layers=3,\n                 dim_feedforward=1024, dropout=0.1, max_len=30, pad_id=0):\n        super().__init__()\n        self.feature_dim = feature_dim\n        self.vocab_size = vocab_size\n        self.d_model = d_model\n        self.max_len = max_len\n        self.pad_id = pad_id\n\n        self.image_projection = nn.Sequential(\n            nn.Linear(feature_dim, d_model),\n            nn.LayerNorm(d_model),\n        )\n\n        self.token_embedding = nn.Embedding(vocab_size, d_model, padding_idx=pad_id)\n        self.position_embedding = nn.Embedding(max_len, d_model)\n\n        decoder_layer = nn.TransformerDecoderLayer(\n            d_model=d_model, nhead=nhead, dim_feedforward=dim_feedforward,\n            dropout=dropout, activation=\"gelu\", batch_first=True, norm_first=True,\n        )\n        self.decoder = nn.TransformerDecoder(decoder_layer, num_layers=num_layers,\n                                              norm=nn.LayerNorm(d_model))\n        self.output_layer = nn.Linear(d_model, vocab_size)\n        self.dropout = nn.Dropout(dropout)\n\n    def forward(self, image_feature, caption_ids):\n        \"\"\"\n        image_feature: [B, feature_dim] - 1 vector / anh (da lay tu feature cache)\n        caption_ids:   [B, L] - chuoi token dau vao (bat dau bang <bos>)\n        \"\"\"\n        B, L = caption_ids.shape\n        device = caption_ids.device\n\n        memory = self.image_projection(image_feature).unsqueeze(1) \n\n        positions = torch.arange(L, device=device).unsqueeze(0).expand(B, L)\n        tgt = self.token_embedding(caption_ids) + self.position_embedding(positions)\n        tgt = self.dropout(tgt)\n\n        causal_mask = torch.triu(torch.full((L, L), float(\"-inf\"), device=device), diagonal=1)\n        pad_mask = (caption_ids == self.pad_id)\n\n        out = self.decoder(tgt=tgt, memory=memory, tgt_mask=causal_mask,\n                            tgt_key_padding_mask=pad_mask)\n        return self.output_layer(out) \n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T13:24:25.664604Z","iopub.execute_input":"2026-08-08T13:24:25.664920Z","iopub.status.idle":"2026-08-08T13:24:25.672880Z","shell.execute_reply.started":"2026-08-08T13:24:25.664896Z","shell.execute_reply":"2026-08-08T13:24:25.672271Z"}},"outputs":[],"execution_count":79},{"cell_type":"markdown","source":"# Hàm chạy 1 epoch (train/val) + có mix precision ( amp)","metadata":{}},{"cell_type":"code","source":"def train_one_epoch(model, data_loader, optimizer, criterion, scaler):\n    model.train()\n    total_loss_sum, total_token_count = 0.0, 0\n    progress_bar = tqdm(data_loader, desc=\"Training\", leave=False)\n\n    for features, captions, _ in progress_bar:\n        features = features.to(DEVICE, non_blocking=True)\n        captions = captions.to(DEVICE, non_blocking=True)\n\n        input_ids = captions[:, :-1]\n        target_ids = captions[:, 1:]\n\n        optimizer.zero_grad(set_to_none=True)\n        use_amp = DEVICE.type == \"cuda\"\n\n        with torch.amp.autocast(device_type=DEVICE.type, enabled=use_amp):\n            logits = model(features, input_ids)\n            loss_sum = criterion(logits.reshape(-1, logits.size(-1)), target_ids.reshape(-1))\n            valid_token_count = (target_ids != PAD_ID).sum()\n            loss = loss_sum / valid_token_count.clamp_min(1)\n\n        scaler.scale(loss).backward()\n        scaler.unscale_(optimizer)\n        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n        scaler.step(optimizer)\n        scaler.update()\n\n        total_loss_sum += float(loss_sum.detach().item())\n        total_token_count += int(valid_token_count.item())\n        progress_bar.set_postfix(loss=f\"{total_loss_sum / max(total_token_count, 1):.4f}\")\n\n    return total_loss_sum / max(total_token_count, 1)\n\n\n@torch.inference_mode()\ndef validate_one_epoch(model, data_loader, criterion):\n    model.eval()\n    total_loss_sum, total_token_count = 0.0, 0\n    progress_bar = tqdm(data_loader, desc=\"Validation\", leave=False)\n\n    for features, captions, _ in progress_bar:\n        features = features.to(DEVICE, non_blocking=True)\n        captions = captions.to(DEVICE, non_blocking=True)\n        input_ids = captions[:, :-1]\n        target_ids = captions[:, 1:]\n\n        use_amp = DEVICE.type == \"cuda\"\n        with torch.amp.autocast(device_type=DEVICE.type, enabled=use_amp):\n            logits = model(features, input_ids)\n            loss_sum = criterion(logits.reshape(-1, logits.size(-1)), target_ids.reshape(-1))\n\n        valid_token_count = (target_ids != PAD_ID).sum()\n        total_loss_sum += float(loss_sum.item())\n        total_token_count += int(valid_token_count.item())\n        progress_bar.set_postfix(loss=f\"{total_loss_sum / max(total_token_count, 1):.4f}\")\n\n    return total_loss_sum / max(total_token_count, 1)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T13:24:25.673938Z","iopub.execute_input":"2026-08-08T13:24:25.674280Z","iopub.status.idle":"2026-08-08T13:24:25.684546Z","shell.execute_reply.started":"2026-08-08T13:24:25.674245Z","shell.execute_reply":"2026-08-08T13:24:25.683861Z"}},"outputs":[],"execution_count":80},{"cell_type":"markdown","source":"# Train model","metadata":{}},{"cell_type":"code","source":"def train_selected_model(model_name, feature_pack, train_loader, val_loader,\n                          max_epochs=TRAIN_CONFIG[\"max_epochs\"],\n                          learning_rate=TRAIN_CONFIG[\"learning_rate\"],\n                          weight_decay=TRAIN_CONFIG[\"weight_decay\"],\n                          early_stopping_patience=TRAIN_CONFIG[\"early_stopping_patience\"]):\n    set_seed(42)\n    feature_dim = int(feature_pack[\"metadata\"][\"feature_dim\"])\n\n    model_config = {**MODEL_CONFIG_BASE, \"feature_dim\": feature_dim, \"vocab_size\": VOCAB_SIZE,\n                     \"max_len\": MAX_LEN, \"pad_id\": PAD_ID}\n    model = ImageCaptionTransformer(**model_config).to(DEVICE)\n\n    trainable_count = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    print(\"So tham so co the huan luyen (decoder):\", f\"{trainable_count:,}\")\n\n    optimizer = torch.optim.AdamW(model.parameters(), lr=learning_rate, weight_decay=weight_decay)\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode=\"min\", factor=0.5, patience=2)\n    criterion = nn.CrossEntropyLoss(ignore_index=PAD_ID, reduction=\"sum\")\n    scaler = torch.amp.GradScaler(DEVICE.type, enabled=(DEVICE.type == \"cuda\"))\n\n    best_ckpt_path = CHECKPOINT_DIR / f\"{model_name}_best.pth\"\n    history = []\n    best_val_loss = float(\"inf\")\n    best_epoch = 0\n    epochs_without_improvement = 0\n\n    if torch.cuda.is_available():\n        torch.cuda.synchronize()\n    training_start = time.perf_counter()\n\n    for epoch in range(1, max_epochs + 1):\n        epoch_start = time.perf_counter()\n        current_lr = optimizer.param_groups[0][\"lr\"]\n\n        train_loss = train_one_epoch(model, train_loader, optimizer, criterion, scaler)\n        val_loss = validate_one_epoch(model, val_loader, criterion)\n        scheduler.step(val_loss)\n\n        epoch_seconds = time.perf_counter() - epoch_start\n        history.append({\"epoch\": epoch, \"train_loss\": train_loss, \"val_loss\": val_loss,\n                         \"learning_rate\": current_lr, \"epoch_seconds\": epoch_seconds})\n\n        improved = val_loss < best_val_loss\n        if improved:\n            best_val_loss = val_loss\n            best_epoch = epoch\n            epochs_without_improvement = 0\n            torch.save({\n                \"model_name\": model_name,\n                \"model_state_dict\": model.state_dict(),\n                \"optimizer_state_dict\": optimizer.state_dict(),\n                \"scheduler_state_dict\": scheduler.state_dict(),\n                \"epoch\": epoch, \"train_loss\": train_loss, \"val_loss\": val_loss,\n                \"vocabulary\": vocab_data, \"model_config\": model_config,\n                \"feature_metadata\": feature_pack[\"metadata\"], \"split_method\": split_method,\n                \"training_seconds\": time.perf_counter() - training_start,\n            }, best_ckpt_path)\n        else:\n            epochs_without_improvement += 1\n\n        mark = \" <- checkpoint moi tot nhat\" if improved else f\" (khong cai thien: {epochs_without_improvement}/{early_stopping_patience})\"\n        print(f\"Epoch {epoch:02d}/{max_epochs} | lr={current_lr:.2e} | \"\n              f\"train_loss={train_loss:.4f} | val_loss={val_loss:.4f} | \"\n              f\"{epoch_seconds:.1f}s{mark}\")\n\n        if epochs_without_improvement >= early_stopping_patience:\n            print(f\"Dung som (early stopping) tai epoch {epoch}.\")\n            break\n\n    total_training_seconds = time.perf_counter() - training_start\n    history_df = pd.DataFrame(history)\n    history_df.to_csv(LOG_DIR / f\"{model_name}_history.csv\", index=False)\n\n    print(f\"\\nXong. Best epoch={best_epoch}, best val_loss={best_val_loss:.4f}, \"\n          f\"tong thoi gian train={total_training_seconds:.1f}s\")\n    print(f\"Checkpoint tai: {best_ckpt_path}\")\n\n    return model, history_df, best_ckpt_path\n\n\nmodel, history_df, best_ckpt_path = train_selected_model(\n    model_name=MODEL_TO_RUN, feature_pack=feature_pack,\n    train_loader=train_loader, val_loader=val_loader,\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T13:24:25.685373Z","iopub.execute_input":"2026-08-08T13:24:25.685765Z","iopub.status.idle":"2026-08-08T13:54:07.686282Z","shell.execute_reply.started":"2026-08-08T13:24:25.685741Z","shell.execute_r